# ============================================================
# 星海争锋（Godot 4 安卓 RTS）
# ============================================================

# ---- Godot 项目内数据目录（不进仓库）----
# 内含：导出模板（约 426 MB）/ 本机编辑器设置（含本地绝对路径）
#       / 调试签名密钥库 / 本机存档。都是「本机才有意义」的东西。
starcraft-android/Godot/

# Godot 导入缓存 —— 首次打开项目会自动重建
starcraft-android/.godot/

# ---- 构建产物 ----
# APK 体积大且每次构建都变，走 Releases 分发而不是塞进 Git 历史。
starcraft-android/build/
*.apk

# ---- 运行期 / 调试产物 ----
*.log
starcraft-android/shots/emu.log

# 阳性对照驱动器（tests/pos_control.py）改坏源码前的自动备份。
# 正常情况下跑完会自动删；这里兜底，避免异常退出时被误提交。
*.pcbak

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 编辑器 ----
.vscode/
.idea/

# ---- 智能体工作数据（非项目源码，含本机路径）----
.workbuddy-ai/
